<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:baselineAligned="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:layout_gravity="center_horizontal" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="@dimen/dp72">
        <FrameLayout android:layout_width="@dimen/dp618" android:layout_height="@dimen/dp72">
            <TextView android:layout_gravity="center_vertical" android:id="@id/digits" android:paddingLeft="@dimen/text_padding_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" style="@style/DialNumberTextStyle" />
            <ImageView android:layout_gravity="bottom" android:background="@drawable/__52__digital_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <ImageButton android:id="@id/dialpad_clear_btn_id" android:background="@drawable/__52__selector_delete_dial" android:layout_width="@dimen/dp170" android:layout_height="@dimen/dp72" />
    </LinearLayout>
    <LinearLayout android:layout_gravity="center_horizontal" android:orientation="horizontal" android:background="@drawable/__52__dialpad_key_bg" android:layout_width="@dimen/dp800" android:layout_height="@dimen/dp352">
        <include layout="?dialpad_dial" />
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp0">
            <ImageButton android:id="@id/dialpad_dial_btn_id" android:background="@drawable/__52__selector_incoming_dial" android:layout_width="@dimen/dp172" android:layout_height="@dimen/dp176" android:contentDescription="@string/image_desc" />
            <ImageButton android:id="@id/dialpad_back_btn_id" android:background="@drawable/__52__selector_hangup_dial" android:visibility="gone" android:layout_width="@dimen/dp172" android:layout_height="@dimen/dp176" android:contentDescription="@string/image_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
