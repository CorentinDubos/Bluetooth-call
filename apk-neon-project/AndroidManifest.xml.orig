<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:compileSdkVersion="28" android:compileSdkVersionCodename="9" package="com.hzbhd.bluetooth.neon.ui2" platformBuildVersionCode="28" platformBuildVersionName="9">
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <application android:allowBackup="false" android:appComponentFactory="android.support.v4.app.CoreComponentFactory" android:extractNativeLibs="false" android:icon="@drawable/ic_launcher_btphone" android:label="BT Phone Neon 2.1" android:name="com.hzbhd.bluetooth.Bluetooth" android:networkSecurityConfig="@xml/network_security_config" android:theme="@style/config_style">
        <meta-data android:name="hzbhdApp" android:value="true"/>
        <activity android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|fontScale" android:icon="@drawable/ic_launcher_btphone" android:label="BT Phone Neon 2.1" android:launchMode="singleTask" android:name="com.hzbhd.bluetooth.hfp.HfpMainActivity" android:resizeableActivity="@bool/resizeableActivity" android:windowSoftInputMode="stateAlwaysHidden|adjustPan">
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btuiphone"/>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btuiphone"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.imode"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btphone"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="sip"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="vnd.android.cursor.item/phone"/>
                <data android:mimeType="vnd.android.cursor.item/phone_v2"/>
                <data android:mimeType="vnd.android.cursor.item/person"/>
            </intent-filter>
            <meta-data android:name="hzbhdAction" android:value="com.hzbhd.intent.action.btuiphone"/>
        </activity>
        <activity android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|fontScale" android:icon="@drawable/ic_launcher_btaudio" android:label="BT Music Neon 2.1" android:launchMode="singleTask" android:name="com.hzbhd.bluetooth.a2dp.A2dpMainActivity" android:resizeableActivity="true" android:taskAffinity="com.driver.bluetooth.a2dp" android:windowSoftInputMode="stateAlwaysHidden|adjustPan">
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btaudio"/>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btaudio"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.hzbhd.intent.action.btaudio"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data android:name="hzbhdAction" android:value="com.hzbhd.intent.action.btaudio"/>
        </activity>
        <receiver android:name="com.hzbhd.bluetooth.receiver.BluetoothReceiver">
            <intent-filter>
                <action android:name="com.hzbhd.android.settings.ACTION_FACTORY_RESET"/>
            </intent-filter>
        </receiver>
        <service android:name="com.hzbhd.bluetooth.call.BubbleCall"/>
        <activity android:excludeFromRecents="true" android:name="com.hzbhd.bluetooth.ui._h1.CallActivity"/>
    </application>
</manifest>
