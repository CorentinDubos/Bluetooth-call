<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="#020406" android:layout_width="fill_parent" android:layout_height="fill_parent" android:baselineAligned="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageButton android:id="@id/dialpad_dial_btn_id" android:background="@drawable/selector_dialpad_btn_bg" android:visibility="gone" android:layout_width="wrap_content" android:src="@drawable/dial_icon" android:contentDescription="@string/image_desc" style="@style/ImageButtonStyle" />
            <ImageButton android:id="@id/dialpad_back_btn_id" android:background="@drawable/selector_dialpad_btn_bg" android:visibility="gone" android:src="@drawable/unpair_icon" android:contentDescription="@string/image_desc" style="@style/ImageButtonStyle" />
        </LinearLayout>
        <include layout="?dialpad_dial" />
    </LinearLayout>
</LinearLayout>
