<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent" android:background="#020406"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_above="@id/a2dp_controls" android:layout_alignParentTop="true" android:layout_marginStart="@dimen/dp42" android:layout_marginTop="@dimen/dp30" android:layout_marginEnd="@dimen/dp42" android:layout_marginBottom="@dimen/dp18">
