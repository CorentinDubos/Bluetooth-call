    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@id/a2dp_controls" android:layout_width="fill_parent" android:layout_height="@dimen/dp104" android:layout_alignParentBottom="true" android:layout_marginBottom="@dimen/dp16">
